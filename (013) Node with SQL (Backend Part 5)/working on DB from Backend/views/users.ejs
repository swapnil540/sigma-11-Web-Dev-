<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All users</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>All Users information</h1>

    <table border="2">
        <tr>
            <th>id</th>
            <th>username</th>
            <th>email</th>
            <th>options</th>
        </tr>
        <% for(user of users) { %>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.email %></td>
                <td>
                    <a href="/users/<%= user.id %>/edit"><button>Edit username</button></a> <br> <br>
                    <form method="get" action="/users/<%= user.id %>/authenticate">
                        <button>Delete</button>
                    </form>
                </td>
            
            </tr>
        <% } %>
    </table>
</body>
</html>