<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit twit</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Edit Twit  Content</h1>
    <p>twit id: <%= twit.id %> </p>
    <p>twit username: @<%= twit.username %> </p>
    <form method="post" action="/twits/<%= twit.id %>?_method=patch">
        <textarea rows="10" cols="35" name="newContent" id="content"> <%= twit.content %></textarea> <br> <br>
        <button>Submit</button>
    </form>
</body>
</html>